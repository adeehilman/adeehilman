# Copy to .env for local runs. NEVER commit the filled-in version.

# Your own TikTok handle, without the "@".
TIKTOK_USERNAME=yourhandle

# Path to the Playwright storage_state produced by scripts/capture_session.py.
TIKTOK_SESSION_FILE=storage_state.json

# Alternative to the file: base64 of that same JSON. This is what CI uses
# (repository secret TIKTOK_SESSION_B64). The file wins if both are set.
# TIKTOK_SESSION_B64=

# --- Safety rails -------------------------------------------------------
# Nothing is ever sent unless BOTH DRY_RUN=false and ALLOW_SEND=true.
DRY_RUN=true
ALLOW_SEND=false

# Hard cap on messages per run.
MAX_MESSAGES=5

# Randomised pause between two sends, in seconds.
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=120

# Do not message the same account again within this many days.
RESEND_COOLDOWN_DAYS=30

# What to send. "emoji" types a character into the chat box; "sticker" opens
# the sticker/emoji panel and clicks an item from it.
MESSAGE_MODE=emoji
STICKER_EMOJI=🎉
STICKER_INDEX=0

# Run the browser with a visible window (local debugging only).
HEADLESS=true
